, "unit_next": -2.6, "status": "loss"}, {"platform": "A", "item": "雙主菜便當", "sales": 29050, "unit_next": 34.0, "status": "ok"}, {"platform": "B", "item": "雙主菜便當", "sales": 28120, "unit_next": 44.0, "status": "ok"}], "promos": [{"key": "A-PROMO1", "platform": "A", "name": "滿 199 折 40（店家全額負擔）", "orders": 354, "merchant_discount": 14160, "contribution": 4198, "per_order": 11.9, "status": "ok"}, {"key": "B-PROMO1", "platform": "B", "name": "控肉便當 買一送一", "orders": 66, "merchant_discount": 8580, "contribution": -3892, "per_order": -59.0, "status": "loss"}, {"key": "B-PROMO2", "platform": "B", "name": "滿 300 折 30（平台共同負擔）", "orders": 75, "merchant_discount": 1125, "contribution": 4792, "per_order": 63.9, "status": "ok"}, {"key": "B-PROMO3", "platform": "B", "name": "古早味紅茶 8 折", "orders": 207, "merchant_discount": 1220, "contribution": 5022, "per_order": 24.3, "status": "ok"}], "ads": [{"key": "A-AD1", "platform": "A", "spend": 1152, "orders": 197, "sales": 36925, "contribution": 3876, "net_if_all_incremental": 2724, "status": "ok"}, {"key": "A-AD2", "platform": "A", "spend": 6055, "orders": 150, "sales": 28995, "contribution": 3323, "net_if_all_incremental": -2732, "status": "loss"}, {"key": "B-AD1", "platform": "B", "spend": 305, "orders": 168, "sales": 29905, "contribution": 2868, "net_if_all_incremental": 2563, "status": "ok"}], "refunds": [{"key": "貢丸湯", "item": "貢丸湯", "refund_orders": 50, "orders_with_item": 380, "rate": 0.1316, "amount": 2465, "status": "hot"}, {"key": "雞腿便當", "item": "雞腿便當", "refund_orders": 2, "orders_with_item": 250, "rate": 0.008, "amount": 290, "status": "ok"}, {"key": "雙主菜便當", "item": "雙主菜便當", "refund_orders": 2, "orders_with_item": 269, "rate": 0.0074, "amount": 525, "status": "ok"}], "legend": "unit_next＝新費率下每賣一份實拿幾元；status: loss＝賠錢, thin＝幾乎沒賺；ads 的 loss＝就算帶來的單全算廣告功勞也不划算, doubt＝若一半的單本來就會來則不划算"}, "t": 22.9}, {"i": 7, "thought": "有問題的品項有 A/B 魚排便當、A/B 素食便當；先用 price_options 看這四個的各種售價試算，再決定調價。", "tool": "price_options", "args": {"targets": [["A", "魚排