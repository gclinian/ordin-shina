alyze 取得每個品項、活動、廣告、退款的實拿數字。", "tool": "analyze", "args": {}, "result": {"totals": {"sales": 431185, "payout": 237378, "commission": 147800, "merchant_discount": 43022, "refunds": 2985, "ad_spend": 8965, "var_cost": 210983, "actual_contribution": 17430, "contribution_now": 17379, "contribution_next": 12124, "rate_change_impact": -5255, "direct_contribution": 223866, "direct_sales": 412750, "orders": 2074, "by_platform_next": {"A": 27421, "B": -6332}, "aov": {"A": 203, "B": 213}}, "problem_items": [{"platform": "A", "item": "紅油抄手", "price": 95.0, "dine": 75.0, "qty": 350, "sales": 33250, "unit_now": 8.7, "unit_next": 6.2, "month_next": 1750, "status": "thin"}, {"platform": "A", "item": "招牌水餃", "price": 70.0, "dine": 70.0, "qty": 221, "sales": 15470, "unit_now": -1.2, "unit_next": -3.1, "month_next": -5133, "status": "loss"}, {"platform": "B", "item": "牛肉湯麵", "price": 110.0, "dine": 110.0, "qty": 80, "sales": 8800, "unit_now": -3.0, "unit_next": -3.0, "month_next": -907, "status": "loss"}, {"platform": "B", "item": "紅油抄手", "price": 75.0, "dine": 75.0, "qty": 538, "sales": 40350, "unit_now": -6.3, "unit_next": -6.3, "month_next": -19472, "status": "loss"}, {"platform": "B", "item": "招牌水餃", "price": 85.0, "dine": 70.0, "qty": 144, "sales": 12240, "unit_now": 5.8, "unit_next": 5.8, "month_next": -111, "status": "thin"}], "ok_item_count": 19, "top_revenue_items": [{"platform": "B", "item": "紅燒牛肉麵", "sales": 79380, "unit_next": 28.6, "status": "ok"}, {"platform": "A", "item": "紅燒牛肉麵", "sales": 65715, "unit_next": 38.6, "status": "ok"}, {"platform": "B", "item": "紅油抄手", "sales": 40350, "unit_next": -6.3, "status": "loss"}, {"platform": "A", "item": "紅油抄手", "sales": 33250, "unit_next": 6.2, "status": "thin"}, {"platform": "B", "item": "滷味拼盤", "sales": 24800, "unit_next": 26.9, "status": "ok"}], "promos": [{"key": "A-PROMO1", "platform": "A", "name": "招牌水餃 6 折", "orders": 169, "merchant_discount": 5544, "contribution": -1580, "per_order": -9.4, "status": "loss"}, {"key": "A-PR